{
  "pages": [
    // pages 数组中第一项为应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationBarBackgroundColor": "#0f172a",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/device/list",
      "style": {
        "navigationBarTitleText": "我的设备",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/device/bind",
      "style": {
        "navigationBarTitleText": "绑定设备",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/photo/list",
      "style": {
        "navigationBarTitleText": "照片列表",
        "navigationBarBackgroundColor": "#f8fafc",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/photo/detail",
      "style": {
        "navigationBarTitleText": "照片详情",
        "navigationBarBackgroundColor": "#0f172a",
        "navigationBarTextStyle": "white"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智能相机云端",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
